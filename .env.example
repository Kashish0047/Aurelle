# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://aurelle.example.com

# Optional: overrides booking.provider from src/config/booking.config.ts
# One of: google-sheets | supabase | email | whatsapp-link | webhook
BOOKING_PROVIDER=

# google-sheets: Apps Script web app URL + the SECRET you set in docs/google-apps-script.gs
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SECRET=

# ── Supabase (admin panel + "supabase" booking provider) ─────────────────
# Project Settings → API Keys. One Supabase project per client.
# URL + anon/publishable key are safe in the browser: row-level security limits them to
# reading published content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key: SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never commit it.
# Only the booking API uses it (to call create_booking / booked_counts).
SUPABASE_SERVICE_ROLE_KEY=

# email (Resend)
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM=

# webhook (Zapier / Make / n8n). Secret is optional, sent as the X-Booking-Secret header.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=
