{
  "name": "aurelle-salon-template",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic, scroll-driven, config-first website template for beauty salons, spas and bridal studios.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "placeholders": "node scripts/generate-placeholders.mjs",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.mjs",
    "clear-image-cache": "node -e \"for (const d of ['.next/cache/images','.next/dev/cache/images']) require('fs').rmSync(d,{recursive:true,force:true});console.log('Image cache cleared (dev + production). Hard-refresh the browser: Ctrl+Shift+R')\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.8.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
